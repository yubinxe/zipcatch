{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/routines",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/routines",
      "schedule": "0 23 * * *"
    },
    {
      "path": "/api/cron/routines",
      "schedule": "30 0 * * 1-5"
    },
    {
      "path": "/api/cron/routines",
      "schedule": "20 0 * * *"
    }
  ]
}
