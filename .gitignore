# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.data/
/artifacts/
/lint-report.json
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# local IDE / agent
.claude/

# typescript
*.tsbuildinfo
next-env.d.ts

# supabase CLI 로컬 캐시
supabase/.temp/

# PPT 작업 파일 — 산출물이지 소스가 아니다
PPT/

# 사업보고 PDF — 산출물이다. 스크립트로 다시 만들 수 있으므로 저장소에 두지 않는다.
docs/보고/pages/
docs/보고/*.pdf
