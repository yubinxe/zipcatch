# 공공데이터포털(data.go.kr) 인증키 하나로 두 곳을 쓴다.
#  - 청약홈 OpenAPI (분양 모집공고 · 경쟁률 · 당첨자 통계)
#  - LH 청약플러스 임대공고 (국민임대 · 행복주택 · 매입임대 …)
# 서비스별로 "활용신청"이 각각 승인돼야 한다. 승인 전에는 해당 출처만 실패로 보고된다.
#
# 옛 이름은 PUBLIC_DATA_API_KEY 였다. '공공데이터'를 옮긴 말이지 공개 키라는 뜻이
# 아닌데 배포 플랫폼이 PUBLIC_ 접두사를 공개 노출로 읽어서 이름을 바꿨다.
# 옛 이름도 계속 읽으므로 기존 설정은 깨지지 않는다.
DATA_GO_KR_API_KEY=여기에_공공데이터포털_API키_입력

# (선택) 카카오톡 "나에게 보내기" 알림 발송용 액세스 토큰.
# 미설정 시 알림은 발송되지 않고 payload 만 저장되어 Dashboard 에 미리보기로 표시됩니다.
# https://developers.kakao.com — talk_message 동의항목 필요
KAKAO_ACCESS_TOKEN=

# 운영 화면(/admin/*) 접속 코드. 설정하지 않으면 운영 화면 전체가 잠깁니다.
# 기본 암호는 두지 않습니다.
ADMIN_PASSCODE=

# ── Supabase (없으면 메모리 저장으로 폴백, 서버 재시작 시 소멸) ──
# service role 키는 서버에서만 쓰며 브라우저로 내보내지 않는다.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── 이메일 알림 (기본 채널 · 없으면 발송하지 않고 원문만 보관) ──
# https://resend.com 에서 발급. 서버에서만 읽으며 브라우저로 내보내지 않는다.
RESEND_API_KEY=
# 발신자. 도메인 인증 전에는 onboarding@resend.dev 로만 나간다.
NOTIFICATION_FROM=집캐치 <onboarding@resend.dev>

# ── (선택) 텔레그램 알림 — 보조 채널 ──
# chat id 를 사용자가 직접 찾아 입력해야 해서 기본 채널로 쓰지 않는다.
TELEGRAM_BOT_TOKEN=

# 알림 링크에 쓸 사이트 주소
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 매칭 임계치 (미설정 시 기본값 사용)
MATCH_NOTIFY_THRESHOLD=75
MATCH_CANDIDATE_THRESHOLD=45
MATCH_MAX_NOTIFY=20

# 루틴 예약 실행(Vercel Cron) 인증 토큰.
# 없으면 /api/cron/routines 가 503 으로 닫히고 루틴은 수동 실행만 된다.
# 이 경로가 열려 있으면 아무나 알림 발송을 트리거할 수 있으므로 반드시 채운다.
CRON_SECRET=

# ── (선택) 소상공인시장진흥공단 상가(상권)정보 — 공고 상세 '걸어서 닿는 생활' ──
# 공공데이터포털에서 이 서비스 활용신청이 승인된 키. 없으면 DATA_GO_KR_API_KEY 로 물러선다.
SBIZ_API_KEY=

# ── HUG 빅데이터 개방 포털 Open API — 분양아파트 공정률(지역별) ──
# HUG 포털(khug.or.kr)이 승인한 키. 공공데이터포털 키(DATA_GO_KR_API_KEY)와 다르다.
# 서버에서만 읽는다. NEXT_PUBLIC_ 을 붙이지 않는다. 없으면 홈의 '지금 짓고 있는 집'이 미연동으로 표시된다.
HUG_API_KEY=
